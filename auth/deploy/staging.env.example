APP_ENV=staging
DB_DRIVER=mysql
DB_HOST=<staging-db-host>
DB_PORT=3306
DB_NAME=azmigrantat_users_staging
DB_USER=azmigrantat_users_staging
DB_PASS=<staging-only-password>
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

VIDEO_STORAGE_PROVIDER=dedicated
VIDEO_SERVICE_URL=https://video-staging.azmigrantat.com
VIDEO_SERVICE_PUBLIC_URL=https://video-staging.azmigrantat.com
VIDEO_SERVICE_TOKEN_SECRET=<staging-only-secret>
VIDEO_SERVICE_ADMIN_SECRET=<staging-only-secret>
VIDEO_SERVICE_CALLBACK_SECRET=<staging-only-secret>
