# Остават във файла само ключовете, нужни преди базата.
# Останалите се редактират от /admin/env-variables?password=MIGRATION_PASSWORD
# и имат по две стойности (development / production).
# Активната колона се избира от /admin/settings.

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=...
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

DATABASE_ADMIN_EMAIL=...
DATABASE_ADMIN_PASSWORD=...

MIGRATION_PASSWORD=123456
APP_ENV=development
PAYMENTS_ENABLED=false

# Facebook Login is deny-by-default. FACEBOOK_APP_SECRET stays on the backend.
FACEBOOK_AUTH_ENABLED=false
FACEBOOK_APP_ID=1660811815677126
FACEBOOK_APP_SECRET=
# Comma-separated dedicated OAuth client IDs. Never use the shared production
# mobile client for development-only Facebook access.
FACEBOOK_ALLOWED_CLIENT_IDS=

# New uploads use the Dedicated service. Existing Bunny rows keep their stored
# provider and continue to play from Bunny until they are migrated explicitly.
VIDEO_STORAGE_PROVIDER=oneprovider
# The mobile client must receive the public HTTPS TUS endpoint.
VIDEO_SERVICE_URL=https://video.azmigrantat.com
VIDEO_SERVICE_PUBLIC_URL=https://video.azmigrantat.com
VIDEO_SERVICE_TOKEN_SECRET=
VIDEO_SERVICE_ADMIN_SECRET=
VIDEO_SERVICE_CALLBACK_SECRET=
VIDEO_SERVICE_MAX_UPLOAD_BYTES=2147483648
VIDEO_SERVICE_TOKEN_TTL_SECONDS=900

# Stripe subscriptions: create the prices in Stripe Dashboard and paste their price IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_CREATOR_PLUS=
STRIPE_PRICE_CREATOR_PRO=
STRIPE_SUCCESS_URL=https://azmigrantat.com/subscriptions/success
STRIPE_CANCEL_URL=https://azmigrantat.com/subscriptions/cancel
