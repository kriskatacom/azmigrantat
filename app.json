{
  "expo": {
    "name": "Ето ме",
    "slug": "chat-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chatapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification", "voip"]
      },
      "bitcode": false,
      "bundleIdentifier": "com.anonymous.chatapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E3545",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.chatapp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.TURN_SCREEN_ON",
        "android.permission.DISABLE_KEYGUARD",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/incoming_call.wav",
            "./assets/sounds/receive_message.wav"
          ],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "./plugins/withIncomingCall.js",
      "@config-plugins/react-native-webrtc",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E3545",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Разрешете достъп до снимките, за да можете да ги изпращате в чата.",
          "cameraPermission": "Разрешете достъп до камерата, за да можете да снимате и изпращате в чата."
        }
      ],
      "expo-document-picker",
      [
        "expo-media-library",
        {
          "photosPermission": "Разрешете достъп до снимките, за да можете да запазвате изображения от чата.",
          "savePhotosPermission": "Разрешете запазването на изображения от чата в галерията.",
          "granularPermissions": []
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsImageWithMaxCount": 5,
              "supportsMovieWithMaxCount": 5,
              "supportsFileWithMaxCount": 5
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["*/*"],
            "multipleShareMimeTypes": ["*/*"]
          }
        }
      ],
      "./plugins/withShareIntent.js",
      "@react-native-google-signin/google-signin",
      [
        "expo-audio",
        {
          "microphonePermission": "Разрешете достъп до микрофона, за да записвате и изпращате аудио съобщения.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65e59c12-75f5-406c-a444-f5d39f2f481d"
      }
    }
  }
}
