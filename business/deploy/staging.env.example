APP_ENV=staging
ETOME_APP_SERVER_URL=https://users-staging.azmigrantat.com
AUTH_SERVER_URL=https://users-staging.azmigrantat.com
OAUTH_SERVER_URL=https://users-staging.azmigrantat.com
OAUTH_CLIENT_ID=<staging-business-oauth-client-id>
OAUTH_CLIENT_SECRET=<staging-only-secret>
OAUTH_REDIRECT_URI=https://business-staging.azmigrantat.com/auth/callback
SESSION_NAME=ETOME_BUSINESS_STAGING
UPLOAD_STORAGE_ROOT=/srv/azmigrantat/business-staging/uploads

DB_DRIVER=mysql
DB_HOST=<staging-db-host>
DB_PORT=3306
DB_NAME=azmigrantat_business_staging
DB_USER=azmigrantat_business_staging
DB_PASS=<staging-only-password>
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci

SMTP_HOST=<staging-smtp-host>
SMTP_AUTH=true
SMTP_USER=<staging-smtp-user>
SMTP_PASS=<staging-smtp-password>
SMTP_SECURE=tls
SMTP_PORT=587
