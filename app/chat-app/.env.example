# Android compatibility mode: every build profile uses shared production services.
# Development and internal Android builds can read and modify real production data.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_URL=https://users.azmigrantat.com
EXPO_PUBLIC_BUSINESS_API_URL=https://business.azmigrantat.com
EXPO_PUBLIC_SUBSCRIPTIONS_URL=https://users.azmigrantat.com/subscriptions
EXPO_PUBLIC_SOCKET_URL=https://realtime.azmigrantat.com
EXPO_PUBLIC_VIDEO_SERVICE_URL=https://video.azmigrantat.com
EXPO_PUBLIC_CLIENT_ID=app_hpte5xcxll63
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=149310026747-0276747vvqrhrgapqcqlg9o1uekn2snr.apps.googleusercontent.com
EXPO_PUBLIC_ENABLE_GOOGLE_SIGN_IN=true
# Enable only in a native development build configured with FACEBOOK_CLIENT_TOKEN.
EXPO_PUBLIC_ENABLE_FACEBOOK_SIGN_IN=false
# Set as a local/EAS secret, never commit the real value.
FACEBOOK_CLIENT_TOKEN=
# Explicit native config opt-in. Runtime still requires a real React Native debug build (__DEV__).
FACEBOOK_NATIVE_DEBUG_BUILD=false
EXPO_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=true
EXPO_PUBLIC_FORCE_TURN=false
EXPO_PUBLIC_LIVE_MEDIA_PROVIDER=mediasoup
EXPO_PUBLIC_DISABLE_HOME_VIDEO_FEED=false
EXPO_PUBLIC_ENABLE_PAYMENTS=false
