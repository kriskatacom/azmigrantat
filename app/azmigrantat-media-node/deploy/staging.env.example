APP_ENV=staging
MEDIA_NODE_ID=media-node-staging-1
MEDIA_NODE_HOST=127.0.0.1
MEDIA_NODE_PORT=3004
MEDIA_NODE_ADVERTISED_HOST=<staging-rtc-host>
MEDIA_NODE_SIGNALING_URL=https://live-staging.azmigrantat.com
MEDIA_NODE_CONTROL_HOST=127.0.0.1
MEDIA_NODE_INTERNAL_SECRET=<same-staging-only-media-secret>
MEDIASOUP_MIN_PORT=40500
MEDIASOUP_MAX_PORT=40599
REDIS_URL=redis://<staging-redis-user>:<password>@127.0.0.1:6379/1
REDIS_KEY_PREFIX=azmigrantat:realtime:staging:
MEDIA_NODE_HEARTBEAT_INTERVAL_MS=5000
