VIDEO_SERVICE_HOST=127.0.0.1
VIDEO_SERVICE_PORT=3100
VIDEO_SERVICE_ROOT=/srv/azmigrantat-video
VIDEO_SERVICE_TOKEN_SECRET=replace-with-a-long-random-secret
VIDEO_SERVICE_ADMIN_SECRET=replace-with-a-different-delete-secret
VIDEO_SERVICE_MAX_UPLOAD_BYTES=2147483648
VIDEO_SERVICE_MAX_CHUNK_BYTES=8388608
VIDEO_SERVICE_ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/webm,video/x-m4v
VIDEO_SERVICE_TOKEN_TTL_SECONDS=900
REDIS_URL=redis://127.0.0.1:6379
VIDEO_SERVICE_QUEUE_KEY=azmigrantat:video:processing
VIDEO_SERVICE_CALLBACK_URL=
VIDEO_SERVICE_CALLBACK_SECRET=
VIDEO_SERVICE_PUBLIC_URL=https://video.azmigrantat.com
VIDEO_WORKER_CONCURRENCY=1
VIDEO_PROCESSING_MIN_FREE_BYTES=10737418240
VIDEO_PROCESSING_MAX_RETRIES=3
VIDEO_PROCESSING_LEASE_SECONDS=900
VIDEO_PROCESSING_RETENTION_SECONDS=86400
VIDEO_PROCESSING_TIMEOUT_SECONDS=900
FFPROBE_BIN=ffprobe
FFMPEG_BIN=ffmpeg

# Bunny migration CLI. Keep these values only in a root-owned deployment env file.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST_NAME=
BUNNY_STREAM_TOKEN_SECURITY_KEY=
BUNNY_HLS_URL_TEMPLATE=
BUNNY_ORIGINAL_URL_TEMPLATE=
BUNNY_MP4_URL_TEMPLATE=
BUNNY_MIGRATION_DB_HOST=127.0.0.1
BUNNY_MIGRATION_DB_PORT=3306
BUNNY_MIGRATION_DB_NAME=
BUNNY_MIGRATION_DB_USER=
BUNNY_MIGRATION_DB_PASSWORD=
# Production must use the default `videos` table. The override below is only
# accepted for explicitly enabled, allowlisted isolated E2E shadow tables.
BUNNY_MIGRATION_DB_TABLE=videos
BUNNY_MIGRATION_ALLOW_TEST_TABLE=0
BUNNY_MIGRATION_EXPECTED_DB_NAME=
BUNNY_MIGRATION_STATE_FILE=/srv/azmigrantat-video/state/bunny-migration.json
BUNNY_MIGRATION_LOCK_FILE=/srv/azmigrantat-video/state/bunny-migration.lock
BUNNY_MIGRATION_BACKUP_FILE=/srv/azmigrantat-video/state/bunny-migration-backup.json
BUNNY_MIGRATION_INVENTORY_FILE=/srv/azmigrantat-video/state/bunny-migration-inventory.json
BUNNY_MIGRATION_MAPPING_FILE=/srv/azmigrantat-video/state/bunny-migration-mapping.json
BUNNY_MIGRATION_LOG_FILE=/srv/azmigrantat-video/logs/bunny-migration.jsonl
BUNNY_MIGRATION_DOWNLOAD_ROOT=/srv/azmigrantat-video/private/migrations/bunny
BUNNY_MIGRATION_PUBLIC_URL_TEMPLATE=
BUNNY_MIGRATION_THUMBNAIL_URL_TEMPLATE=
BUNNY_MIGRATION_REQUIRE_HLS=0
