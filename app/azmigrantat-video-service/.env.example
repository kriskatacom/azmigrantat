VIDEO_SERVICE_HOST=127.0.0.1
VIDEO_SERVICE_PORT=3100
VIDEO_SERVICE_ROOT=/srv/azmigrantat-video
VIDEO_SERVICE_TOKEN_SECRET=replace-with-a-long-random-secret
VIDEO_SERVICE_ADMIN_SECRET=replace-with-a-different-delete-secret
VIDEO_SERVICE_MAX_UPLOAD_BYTES=2147483648
VIDEO_SERVICE_MAX_CHUNK_BYTES=8388608
VIDEO_SERVICE_ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/webm,video/x-m4v
VIDEO_SERVICE_TOKEN_TTL_SECONDS=900
REDIS_URL=redis://127.0.0.1:6379
VIDEO_SERVICE_QUEUE_KEY=azmigrantat:video:processing
VIDEO_SERVICE_CALLBACK_URL=
VIDEO_SERVICE_CALLBACK_SECRET=
VIDEO_SERVICE_PUBLIC_URL=https://video.azmigrantat.com
VIDEO_WORKER_CONCURRENCY=1
VIDEO_PROCESSING_MIN_FREE_BYTES=10737418240
VIDEO_PROCESSING_MAX_RETRIES=3
VIDEO_PROCESSING_LEASE_SECONDS=900
VIDEO_PROCESSING_RETENTION_SECONDS=86400
VIDEO_PROCESSING_TIMEOUT_SECONDS=900
FFPROBE_BIN=ffprobe
FFMPEG_BIN=ffmpeg

# Optional video enhancement. Keep disabled until the production host has been
# benchmarked with representative 360p/480p clips and these FPS values are
# replaced with measured conservative p10 throughput.
VIDEO_ENHANCEMENT_ENABLED=0
VIDEO_ENHANCEMENT_AI_ENABLED=0
VIDEO_ENHANCEMENT_QUEUE_KEY=azmigrantat:video:enhancement
VIDEO_ENHANCEMENT_AI_QUEUE_KEY=azmigrantat:video:enhancement:ai
VIDEO_ENHANCEMENT_AI_READINESS_KEY=azmigrantat:video:enhancement:ai:readiness
VIDEO_ENHANCEMENT_AI_READINESS_TTL_SECONDS=45
VIDEO_ENHANCEMENT_MAX_TOTAL_SECONDS=300
VIDEO_ENHANCEMENT_AI_MAX_TOTAL_SECONDS=7200
VIDEO_ENHANCEMENT_AI_LEASE_SECONDS=120
VIDEO_ENHANCEMENT_AI_MAX_ATTEMPTS=2
VIDEO_ENHANCEMENT_AI_PREEMPT_CHECK_MS=1000
VIDEO_ENHANCEMENT_FINALIZE_RESERVE_SECONDS=20
VIDEO_ENHANCEMENT_CONCURRENCY=1
VIDEO_ENHANCEMENT_FAST_720_FPS=70
VIDEO_ENHANCEMENT_FAST_1080_FPS=35
VIDEO_ENHANCEMENT_AI_720_FPS=0.2
VIDEO_ENHANCEMENT_AI_1080_FPS=0.1
VIDEO_ENHANCEMENT_MAX_720_DURATION_SECONDS=240
VIDEO_ENHANCEMENT_MAX_1080_DURATION_SECONDS=120
VIDEO_ENHANCEMENT_MAX_AI_DURATION_SECONDS=5
VIDEO_ENHANCEMENT_MAX_AI_720_DURATION_SECONDS=5
VIDEO_ENHANCEMENT_MAX_AI_1080_DURATION_SECONDS=5
VIDEO_ENHANCEMENT_MAX_LOAD_PER_CPU=0.70
VIDEO_ENHANCEMENT_MIN_AVAILABLE_MEMORY_BYTES=4294967296
VIDEO_ENHANCEMENT_MAX_QUEUE_DEPTH=1
VIDEO_ENHANCEMENT_FFMPEG_THREADS=6
VIDEO_ENHANCEMENT_AI_MAX_QUEUE_DEPTH=1
VIDEO_ENHANCEMENT_AI_MAX_LOAD_PER_CPU=0.35
VIDEO_ENHANCEMENT_AI_MIN_AVAILABLE_MEMORY_BYTES=17179869184
VIDEO_ENHANCEMENT_AI_MAX_INPUT_PIXELS=2073600
VIDEO_ENHANCEMENT_AI_MAX_WORKSPACE_BYTES=8589934592
VIDEO_ENHANCEMENT_AI_ENGINE=disabled
VIDEO_ENHANCEMENT_AI_COMMAND=
VIDEO_ENHANCEMENT_AI_MODEL_FINGERPRINT=
VIDEO_ENHANCEMENT_AI_ADAPTER_FINGERPRINT=
# Protocol v1 adapter: --preflight returns readiness JSON. Processing receives
# --input, --output, --target-short-side, --deadline-seconds, --natural-detail,
# --preserve-audio, --preserve-timestamps and --max-workspace-bytes and may
# emit progress=0..100. Preflight must confirm workspace-limit enforcement.

# Future remote GPU restoration. The orchestrator is a separate service and is
# deliberately unavailable while provisioning is disabled. Zero budgets deny
# every provisioning decision. Never commit provider or worker secrets.
GPU_ORCHESTRATOR_HOST=127.0.0.1
GPU_ORCHESTRATOR_PORT=3110
GPU_PROVISIONING_ENABLED=0
GPU_PROVIDER=disabled
GPU_MAX_ACTIVE_INSTANCES=1
GPU_MAX_HOURLY_PRICE=0
GPU_MAX_DAILY_BUDGET=0
GPU_MAX_MONTHLY_BUDGET=0
GPU_IDLE_TIMEOUT_SECONDS=300
GPU_CAPABILITY_TTL_SECONDS=900
GPU_BOOTSTRAP_TTL_SECONDS=7200
GPU_WORKER_HEARTBEAT_SECONDS=15
GPU_WORKER_LOST_SECONDS=90
GPU_JOB_TIMEOUT_SECONDS=7200
GPU_WORKER_IMAGE=
GPU_MODEL_MANIFEST_PATH=/opt/azmigrantat-video-service/deploy/gpu-worker/model-manifest.json
GPU_COST_LEDGER_PATH=/srv/azmigrantat-video/state/gpu-cost-ledger.jsonl
GPU_CAPABILITY_SECRET=
GPU_WORKER_ENDPOINTS_ENABLED=0
GPU_MAX_RESULT_BYTES=4294967296
GPU_BENCHMARK_QUEUE_KEY=azmigrantat:video:enhancement:gpu-benchmark
GPU_BOOTSTRAP_TOKEN_FILE=/run/azmigrantat-video/gpu-bootstrap.env
GPU_PROVIDER_API_KEY=
GPU_PROVIDER_API_BASE_URL=
GPU_PROVIDER_REQUEST_TIMEOUT_MS=20000
# Runpod /v2/registries credential ID, not its display name or password.
GPU_REGISTRY_CREDENTIAL_ID=
SWIFTVR_COMMERCIAL_USE_APPROVED=0

# Bunny migration CLI. Keep these values only in a root-owned deployment env file.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST_NAME=
BUNNY_STREAM_TOKEN_SECURITY_KEY=
BUNNY_HLS_URL_TEMPLATE=
BUNNY_ORIGINAL_URL_TEMPLATE=
BUNNY_MP4_URL_TEMPLATE=
BUNNY_MIGRATION_DB_HOST=127.0.0.1
BUNNY_MIGRATION_DB_PORT=3306
BUNNY_MIGRATION_DB_NAME=
BUNNY_MIGRATION_DB_USER=
BUNNY_MIGRATION_DB_PASSWORD=
# Production must use the default `videos` table. The override below is only
# accepted for explicitly enabled, allowlisted isolated E2E shadow tables.
BUNNY_MIGRATION_DB_TABLE=videos
BUNNY_MIGRATION_ALLOW_TEST_TABLE=0
BUNNY_MIGRATION_EXPECTED_DB_NAME=
BUNNY_MIGRATION_STATE_FILE=/srv/azmigrantat-video/state/bunny-migration.json
BUNNY_MIGRATION_LOCK_FILE=/srv/azmigrantat-video/state/bunny-migration.lock
BUNNY_MIGRATION_BACKUP_FILE=/srv/azmigrantat-video/state/bunny-migration-backup.json
BUNNY_MIGRATION_INVENTORY_FILE=/srv/azmigrantat-video/state/bunny-migration-inventory.json
BUNNY_MIGRATION_MAPPING_FILE=/srv/azmigrantat-video/state/bunny-migration-mapping.json
BUNNY_MIGRATION_LOG_FILE=/srv/azmigrantat-video/logs/bunny-migration.jsonl
BUNNY_MIGRATION_DOWNLOAD_ROOT=/srv/azmigrantat-video/private/migrations/bunny
BUNNY_MIGRATION_PUBLIC_URL_TEMPLATE=
BUNNY_MIGRATION_THUMBNAIL_URL_TEMPLATE=
BUNNY_MIGRATION_REQUIRE_HLS=0
