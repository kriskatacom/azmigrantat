#!/usr/bin/env bash
set -Eeuo pipefail

readonly runtime=/opt/azmigrantat-video-ai/runtime/venv/bin/python
readonly adapter=/opt/azmigrantat-video-ai/adapter/light_ai_video.py
readonly model=/opt/azmigrantat-video-ai/models/ESPCN_x2.pb
readonly model_sha256=59f77351e1d7c0057bf6fe088b4a8a07e42c468c8c8aebb674a6b4ea1823221d

export AZMIGRANTAT_AI_MODEL="$model"
export AZMIGRANTAT_AI_EXPECTED_MODEL_SHA256="$model_sha256"
export AZMIGRANTAT_AI_ALGORITHM=espcn
export AZMIGRANTAT_AI_BACKEND=openvino
export AZMIGRANTAT_AI_PROFILE=restore
export AZMIGRANTAT_AI_OPENCV_THREADS=2
export AZMIGRANTAT_AI_REQUIRE_ROOT_OWNED=1
export OMP_NUM_THREADS=2
export OPENBLAS_NUM_THREADS=2
export MKL_NUM_THREADS=2
export HOME="${HOME:-/var/lib/azmigrantat-video-ai}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-/var/cache/azmigrantat-video-ai}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-/var/lib/azmigrantat-video-ai/config}"

exec "$runtime" "$adapter" "$@"
