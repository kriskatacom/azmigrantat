VIDEO_SERVICE_HOST=127.0.0.1
VIDEO_SERVICE_PORT=3101
VIDEO_SERVICE_ROOT=/srv/azmigrantat-video-staging
VIDEO_SERVICE_TOKEN_SECRET=replace-with-staging-upload-secret
VIDEO_SERVICE_ADMIN_SECRET=replace-with-staging-delete-secret
VIDEO_SERVICE_CALLBACK_URL=http://127.0.0.1:18082/internal/video/dedicated/callback
VIDEO_SERVICE_CALLBACK_SECRET=replace-with-staging-callback-secret
VIDEO_SERVICE_PUBLIC_URL=
VIDEO_SERVICE_QUEUE_KEY=azmigrantat:video:staging:processing
# Use the dedicated staging Redis ACL user. Never point staging at production 6379.
REDIS_URL=redis://azmigrantat-staging:replace-with-staging-redis-secret@127.0.0.1:6380
VIDEO_SERVICE_MAX_UPLOAD_BYTES=2147483648
VIDEO_SERVICE_MAX_CHUNK_BYTES=8388608
VIDEO_SERVICE_ALLOWED_MIME_TYPES=video/mp4,video/quicktime,video/webm,video/x-m4v
VIDEO_SERVICE_TOKEN_TTL_SECONDS=900
VIDEO_WORKER_CONCURRENCY=1
VIDEO_PROCESSING_MIN_FREE_BYTES=10737418240
VIDEO_PROCESSING_MAX_RETRIES=3
VIDEO_PROCESSING_LEASE_SECONDS=900
VIDEO_PROCESSING_RETENTION_SECONDS=86400
VIDEO_PROCESSING_TIMEOUT_SECONDS=900
FFPROBE_BIN=/usr/bin/ffprobe
FFMPEG_BIN=/usr/bin/ffmpeg
