# Template only. Do not enable until DNS, TLS certificate paths and firewall
# approval are available.
upstream azmigrantat_video_api {
    server 127.0.0.1:3100;
    keepalive 16;
}

server {
    listen 80;
    server_name video.example.invalid;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name video.example.invalid;

    ssl_certificate /etc/letsencrypt/live/video.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/video.example.invalid/privkey.pem;

    client_max_body_size 2G;
    proxy_request_buffering off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;

    location /v1/ {
        proxy_pass http://azmigrantat_video_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Only finalized public artifacts are exposed. private/ and state/ remain
    # outside the Nginx document root.
    location /videos/ {
        alias /srv/azmigrantat-video/public/videos/;
        autoindex off;
        add_header Accept-Ranges bytes always;
        add_header Cache-Control "public, max-age=86400" always;
    }

    location /thumbnails/ {
        alias /srv/azmigrantat-video/public/thumbnails/;
        autoindex off;
        add_header Cache-Control "public, max-age=86400" always;
    }
}
