APP_ENV=staging
PORT=3003
PHP_API_URL=https://users-staging.azmigrantat.com
INTERNAL_API_SECRET=<staging-only-secret>
# Prefer a separate Redis ACL user and logical database in addition to this prefix.
REDIS_URL=redis://<staging-redis-user>:<password>@127.0.0.1:6379/1
REDIS_KEY_PREFIX=azmigrantat:realtime:staging:
MEDIA_NODE_INTERNAL_SECRET=<staging-only-media-secret>
# Keep disabled until a separate staging Firebase project/service account exists.
FCM_ENABLED=false
# Leave unset while FCM is disabled. Provision separately before enabling in a future change.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
